<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      IMPORTANT:
      - Themes live in: res/values/themes/themes.xml (+ night variant)
      - Text styles live in: res/values/text_appearances.xml
      - Shape overlays live in: res/values/styles_shape_overlays.xml

      Keep this file ONLY for extra one-off widget styles (dialogs, chips, etc.)
      that are NOT duplicated elsewhere.
    -->
    <!-- Simple outlined chip style that works on Material3 themes -->
    <style name="MahoutChipOutlined" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">?attr/colorOutline</item>
        <item name="chipBackgroundColor">?attr/colorSurface</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">12sp</item>
        <item name="chipCornerRadius">14dp</item>
        <item name="chipMinHeight">32dp</item>
    </style>
</resources>
