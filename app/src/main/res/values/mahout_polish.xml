<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- =========================
         Action Card Typography
         ========================= -->

    <!-- Single-line title: prevents ugly mid-word wrapping ("Workou / t"). -->
    <style name="Widget.Mahout.Text.ActionTitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>

        <!-- Helps avoid weird wrapping behavior on some OEMs -->
        <item name="android:breakStrategy">simple</item>
        <item name="android:hyphenationFrequency">none</item>
    </style>

    <style name="Widget.Mahout.Text.ActionMeta" parent="TextAppearance.Material3.BodySmall">
        <item name="android:includeFontPadding">false</item>
    </style>


    <!-- =========================
         Compact Pill Buttons
         ========================= -->

    <!-- Keep these a bit taller than "looks right" to survive font scale and OEM rendering.
         36dp still reads compact but avoids clipping at 1.1–1.3 font scale. -->
    <dimen name="mahout_btn_pill_min_height">36dp</dimen>
    <dimen name="mahout_btn_pill_padding_h">16dp</dimen>

    <style name="Widget.Mahout.Button.PillCompact" parent="Widget.Material3.Button">
        <!-- Shape -->
        <item name="cornerRadius">999dp</item>

        <!-- Keep tap target safe-ish while still compact -->
        <item name="android:minHeight">@dimen/mahout_btn_pill_min_height</item>

        <!-- Padding: vertical is handled mostly by minHeight; horizontal keeps it premium -->
        <item name="android:paddingLeft">@dimen/mahout_btn_pill_padding_h</item>
        <item name="android:paddingRight">@dimen/mahout_btn_pill_padding_h</item>

        <!-- Text rendering -->
        <item name="android:textAllCaps">false</item>
        <item name="android:includeFontPadding">false</item>
    </style>

</resources>
