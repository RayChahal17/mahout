<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!--
      IMPORTANT: The `strokeColor` has been removed from these paths.
      This allows the icon to be tinted by a ColorStateList.
    -->

    <!-- Center the SVG's local coordinate system (around 0,0) -->
    <group
        android:translateX="24"
        android:translateY="24">

        <!-- Head circle: SVG -> <circle cx="-2" cy="-4" r="10.5" /> -->
        <path
            android:fillColor="@android:color/transparent"
            android:strokeWidth="3.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M-12.5,-4 a10.5,10.5 0 1,0 21,0 a10.5,10.5 0 1,0 -21,0" />

        <!-- Cap / upper arc: SVG -> M-15 -6 A13 13 0 0 1 11 -6 -->
        <path
            android:fillColor="@android:color/transparent"
            android:strokeWidth="3.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M-15,-6 A13,13 0 0,1 11,-6" />

        <!-- Band: SVG -> M-13 -6 H7 -->
        <path
            android:fillColor="@android:color/transparent"
            android:strokeWidth="3.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M-13,-6 H7" />


        <!-- Bottom curve: SVG -> M-20 22 C-14 12 10 12 16 22 -->
        <path
            android:fillColor="@android:color/transparent"
            android:strokeWidth="3.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M-20,22 C-14,12 10,12 16,22" />

    </group>
</vector>
