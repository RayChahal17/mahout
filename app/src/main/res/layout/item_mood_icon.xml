<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:foreground="?attr/selectableItemBackgroundBorderless"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <ImageView
        android:id="@+id/ivMoodIcon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:scaleType="centerInside"
        android:tint="@android:color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/tvMoodName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Happy"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:alpha="0.9"
        app:layout_constraintStart_toEndOf="@id/ivMoodIcon"
        app:layout_constraintEnd_toStartOf="@id/ivMoodCheck"
        app:layout_constraintTop_toTopOf="@id/ivMoodIcon"
        app:layout_constraintBottom_toBottomOf="@id/ivMoodIcon"
        android:layout_marginStart="16dp" />

    <ImageView
        android:id="@+id/ivMoodCheck"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_check_24"
        android:tint="@android:color/white"
        android:alpha="0.9"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivMoodIcon"
        app:layout_constraintBottom_toBottomOf="@id/ivMoodIcon" />

</androidx.constraintlayout.widget.ConstraintLayout>
