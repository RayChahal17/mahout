<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/spacing_8"
    android:paddingBottom="@dimen/spacing_8">

    <ImageView
        android:id="@+id/ivMoodHistoryIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:tint="?attr/colorOnSurface"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvMoodHistoryTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Happy"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintStart_toEndOf="@id/ivMoodHistoryIcon"
        app:layout_constraintEnd_toStartOf="@id/btnMoodHistoryDelete"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="@dimen/spacing_12" />

    <TextView
        android:id="@+id/tvMoodHistoryTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="9:41 PM"
        android:textSize="12sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintBaseline_toBaselineOf="@id/tvMoodHistoryTitle"
        app:layout_constraintEnd_toStartOf="@id/btnMoodHistoryDelete"
        android:layout_marginEnd="@dimen/spacing_8" />

    <ImageButton
        android:id="@+id/btnMoodHistoryDelete"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/common_delete"
        android:src="@drawable/ic_delete_24"
        app:tint="?attr/colorOnSurfaceVariant"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvMoodHistoryNote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Optional note…"
        android:textSize="12sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintStart_toStartOf="@id/tvMoodHistoryTitle"
        app:layout_constraintEnd_toEndOf="@id/tvMoodHistoryTitle"
        app:layout_constraintTop_toBottomOf="@id/tvMoodHistoryTitle"
        android:layout_marginTop="@dimen/spacing_4" />

</androidx.constraintlayout.widget.ConstraintLayout>
