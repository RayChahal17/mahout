<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_16">

        <!-- Title (required) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilGoalTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/goal_field_title">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGoalTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Why (optional) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilGoalWhy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="@string/goal_field_why_optional">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGoalWhy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Horizon (auto if target date set) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilHorizon"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="@string/goal_field_horizon">

            <AutoCompleteTextView
                android:id="@+id/actvHorizon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Target date (optional; bounded by Chief Aim year) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilGoalTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="@string/goal_field_target_optional">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGoalTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="true"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Edit-only actions (shown only when existing != null) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewDetails"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:text="@string/goal_action_view_details"
            android:visibility="gone"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteGoal"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:text="@string/goal_action_delete"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>
