<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootAim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mahout_premium_bg"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- Header background -->
    <View
        android:id="@+id/vAimHeaderBg"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:background="@drawable/bg_aim_header_gradient"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Mountain silhouette -->
    <ImageView
        android:id="@+id/ivAimHeaderMountains"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:alpha="0.10"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@id/vAimHeaderBg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="ContentDescription"/>

    <TextView
        android:id="@+id/tvAimTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_16"
        android:text="Aim"
        android:textColor="@color/mahout_premium_on_header"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddGoal"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginEnd="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_16"
        android:minHeight="40dp"
        android:text="Add Goal"
        android:textAllCaps="false"
        android:textColor="@color/mahout_premium_on_header"
        app:icon="@drawable/ic_add_24"
        app:iconPadding="10dp"
        app:iconTint="@color/mahout_premium_on_header"
        app:strokeColor="@color/mahout_premium_on_header_outline"
        app:strokeWidth="1dp"
        app:cornerRadius="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardChiefAim"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/spacing_16"
        android:layout_marginTop="-56dp"
        app:cardBackgroundColor="@color/mahout_premium_surface"
        app:strokeColor="@color/mahout_premium_outline"
        app:strokeWidth="1dp"
        app:cardCornerRadius="26dp"
        app:cardElevation="6dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintTop_toBottomOf="@id/vAimHeaderBg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_16">

            <ImageView
                android:id="@+id/ivChiefAimWatermark"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:alpha="0.08"
                android:scaleType="centerCrop"
                android:src="@drawable/mountain"
                android:layout_marginBottom="-12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="1.0"
                tools:ignore="ContentDescription" />

            <!-- Empty state -->
            <TextView
                android:id="@+id/tvChiefAimEmptyTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Set your Chief Aim"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/mahout_premium_ink_primary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:ignore="HardcodedText"/>

            <TextView
                android:id="@+id/tvChiefAimEmptySubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_6"
                android:text="A 5–20 year aim that guides everything else."
                android:textSize="14sp"
                android:textColor="@color/mahout_premium_ink_secondary"
                app:layout_constraintTop_toBottomOf="@id/tvChiefAimEmptyTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:ignore="HardcodedText"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetChiefAim"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="Set Chief Aim"
                android:textAllCaps="false"
                app:cornerRadius="18dp"
                app:backgroundTint="@color/mahout_premium_accent"
                android:textColor="@color/mahout_premium_on_accent"
                app:layout_constraintTop_toBottomOf="@id/tvChiefAimEmptySubtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:ignore="HardcodedText"/>

            <!-- Content state -->
            <TextView
                android:id="@+id/tvChiefAimTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="22sp"
                android:textColor="@color/mahout_premium_ink_primary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Chief Aim"/>

            <TextView
                android:id="@+id/tvChiefAimDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/mahout_premium_ink_secondary"
                app:layout_constraintTop_toBottomOf="@id/tvChiefAimTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Become a successful businessman&#10;Open 2 companies in next 10 years"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTarget"
                style="@style/Widget.Mahout.Chip.Neutral"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:text="Target · Dec 22, 2033"
                app:chipBackgroundColor="@color/mahout_premium_accent_soft"
                app:chipStrokeColor="@color/mahout_premium_outline"
                app:chipStrokeWidth="1dp"
                android:textColor="@color/mahout_premium_ink_primary"
                app:layout_constraintTop_toBottomOf="@id/tvChiefAimDescription"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:ignore="HardcodedText"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHeroSummary"
                style="@style/Widget.Mahout.Chip.Neutral"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_10"
                android:text="This week · 2h 40m · 12 sessions · Active 4/7 days"
                app:chipBackgroundColor="@color/mahout_premium_surface_alt"
                app:chipStrokeColor="@color/mahout_premium_outline"
                app:chipStrokeWidth="1dp"
                android:textColor="@color/mahout_premium_ink_secondary"
                app:layout_constraintTop_toBottomOf="@id/chipTarget"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:ignore="HardcodedText"/>

            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupChiefAimEmpty"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:constraint_referenced_ids="tvChiefAimEmptyTitle,tvChiefAimEmptySubtitle,btnSetChiefAim,chipHeroSummary"/>

            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupChiefAimContent"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:constraint_referenced_ids="tvChiefAimTitle,tvChiefAimDescription,chipTarget,chipHeroSummary"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Metrics -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clMetrics"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_8"
        app:layout_constraintTop_toBottomOf="@id/cardChiefAim"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMetricTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_10"
            app:cardBackgroundColor="@color/mahout_premium_surface"
            app:strokeColor="@color/mahout_premium_outline"
            app:strokeWidth="1dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/cardMetricSessions">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_12">

                <TextView
                    android:id="@+id/tvMetricTimeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/mahout_premium_ink_primary"
                    tools:text="2h 40m"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Goal time (7d)"
                    android:textSize="12sp"
                    android:textColor="@color/mahout_premium_ink_secondary"
                    app:layout_constraintTop_toBottomOf="@id/tvMetricTimeValue"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:ignore="HardcodedText"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMetricSessions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_10"
            app:cardBackgroundColor="@color/mahout_premium_surface"
            app:strokeColor="@color/mahout_premium_outline"
            app:strokeWidth="1dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:layout_constraintStart_toEndOf="@id/cardMetricTime"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/cardMetricActiveDays">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_12">

                <TextView
                    android:id="@+id/tvMetricSessionsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/mahout_premium_ink_primary"
                    tools:text="12"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Sessions (7d)"
                    android:textSize="12sp"
                    android:textColor="@color/mahout_premium_ink_secondary"
                    app:layout_constraintTop_toBottomOf="@id/tvMetricSessionsValue"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:ignore="HardcodedText"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMetricActiveDays"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/mahout_premium_surface"
            app:strokeColor="@color/mahout_premium_outline"
            app:strokeWidth="1dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:layout_constraintStart_toEndOf="@id/cardMetricSessions"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_12">

                <TextView
                    android:id="@+id/tvMetricActiveDaysValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/mahout_premium_ink_primary"
                    tools:text="4/7"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Active days"
                    android:textSize="12sp"
                    android:textColor="@color/mahout_premium_ink_secondary"
                    app:layout_constraintTop_toBottomOf="@id/tvMetricActiveDaysValue"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:ignore="HardcodedText"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Roadmap header (pinned / should never be covered by RecyclerView) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerRoadmapHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/mahout_premium_bg"
        android:elevation="10dp"
        android:layout_marginTop="@dimen/spacing_16"
        android:paddingBottom="@dimen/spacing_12"
        app:layout_constraintTop_toBottomOf="@id/clMetrics"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvRoadmapTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_16"
            android:layout_marginEnd="@dimen/spacing_16"
            android:layout_marginTop="@dimen/spacing_20"
            android:text="Your roadmap"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/mahout_premium_ink_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:ignore="HardcodedText"/>

        <TextView
            android:id="@+id/tvRoadmapSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_16"
            android:layout_marginEnd="@dimen/spacing_16"
            android:layout_marginTop="@dimen/spacing_6"
            android:text="Goals become real when linked to your Path actions."
            android:textSize="13sp"
            android:textColor="@color/mahout_premium_ink_secondary"
            app:layout_constraintTop_toBottomOf="@id/tvRoadmapTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:ignore="HardcodedText"/>

        <HorizontalScrollView
            android:id="@+id/hsRoadmapBuckets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingStart="@dimen/spacing_16"
            android:paddingEnd="@dimen/spacing_16"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/tvRoadmapSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleRoadmapBuckets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_mahout_segment_container"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:clipToPadding="false"
                android:clipToOutline="true"
                android:outlineProvider="background"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@id/btnBucketNext30">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBucketNext30"
                    style="@style/Widget.Mahout.Button.SegmentItemDark.Left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next 30 days"
                    android:textAllCaps="false"
                    tools:ignore="HardcodedText" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBucket1to6"
                    style="@style/Widget.Mahout.Button.SegmentItemDark.Middle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:text="1–6 months"
                    android:textAllCaps="false"
                    tools:ignore="HardcodedText"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBucket6to24"
                    style="@style/Widget.Mahout.Button.SegmentItemDark.Middle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:text="6–24 months"
                    android:textAllCaps="false"
                    tools:ignore="HardcodedText"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBucket2to10"
                    style="@style/Widget.Mahout.Button.SegmentItemDark.Middle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:text="2–10 years"
                    android:textAllCaps="false"
                    tools:ignore="HardcodedText"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBucketArchived"
                    style="@style/Widget.Mahout.Button.SegmentItemDark.Right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:text="Archived"
                    android:textAllCaps="false"
                    tools:ignore="HardcodedText"/>

            </com.google.android.material.button.MaterialButtonToggleGroup>
        </HorizontalScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvGoalsEmpty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_12"
        android:gravity="center"
        android:textColor="@color/mahout_premium_ink_secondary"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/containerRoadmapHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="No goals yet for this horizon."/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGoals"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_12"
        android:paddingStart="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_16"
        android:paddingBottom="0dp"
        android:clipToPadding="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/containerRoadmapHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_goal"/>

    <include
        android:id="@+id/loadingOverlay"
        layout="@layout/include_loading_overlay"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
