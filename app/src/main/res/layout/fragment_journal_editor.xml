<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootEditor"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mahout_screen"
    android:padding="18dp">

    <!-- Top row: premium back + title -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/ripple_mahout_icon_circle_outline"
        android:padding="10dp"
        android:src="@drawable/ic_arrow_back_24"
        android:contentDescription="@string/back"
        app:tint="@color/mahout_ink_900"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvTitle"
        style="@style/TextAppearance.Mahout.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/mahout_ink_900"
        android:text="@string/mahout_journal"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toStartOf="@id/tvTypePill"/>

    <!-- Type pill (uses your Mahout pill styling) -->
    <TextView
        android:id="@+id/tvTypePill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_mahout_pill_soft_blue"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textStyle="bold"
        android:textSize="12sp"
        android:textColor="@color/mahout_ink_900"
        android:text="NEW"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"/>

    <!-- Main editor card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEditor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:cardUseCompatPadding="true"
        app:cardBackgroundColor="@color/mahout_card_overlay"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintBottom_toTopOf="@id/btnSave"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvTodayLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/today"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/mahout_ink_900"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/tvDateChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_mahout_date_chip"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="@color/mahout_gold_500"
                android:text="Dec 29"
                app:layout_constraintBaseline_toBaselineOf="@id/tvTodayLabel"
                app:layout_constraintStart_toEndOf="@id/tvTodayLabel"/>

            <!-- Prompts (same cards you already use) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPrompts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:layout_constraintTop_toBottomOf="@id/tvTodayLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:listitem="@layout/item_mahout_prompt"/>

            <!-- Lined editor -->
            <com.mahout.app.ui.mahout.LinedEditText
                android:id="@+id/etBody"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:background="@android:color/transparent"
                android:gravity="top|start"
                android:hint="@string/mahout_editor_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:padding="6dp"
                android:textColor="@color/mahout_ink_900"
                android:textColorHint="@color/mahout_ink_500"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/rvPrompts"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Save button pinned to bottom -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        style="@style/Widget.Mahout.Button.PillPrimary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/mahout_save"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
