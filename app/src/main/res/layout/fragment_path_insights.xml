<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/premium_background">

    <!-- Header -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Back"
        android:src="@drawable/ic_arrow_back_24"
        app:tint="?attr/colorOnSurface"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/path_insights_title"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/premium_text_primary"
        android:letterSpacing="0.02"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="18dp"/>

    <!-- Period buttons: Today, Week, Month, Year -->
    <LinearLayout
        android:id="@+id/layoutPeriodButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        android:layout_marginStart="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPeriodToday"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/path_insights_today"
            android:textSize="14sp"
            android:textColor="@color/premium_text_primary"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPeriodWeek"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/path_insights_week"
            android:textSize="14sp"
            android:textColor="@color/premium_text_secondary"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPeriodMonth"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/path_insights_month"
            android:textSize="14sp"
            android:textColor="@color/premium_text_secondary"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPeriodYear"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/path_insights_year"
            android:textSize="14sp"
            android:textColor="@color/premium_text_secondary"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>
    </LinearLayout>

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- Content group -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/layoutPeriodButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- Summary card - Premium design matching Figma -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:cardUseCompatPadding="false"
                app:cardBackgroundColor="#F5F5F5"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp"
                    android:gravity="center_vertical">

                    <!-- Total inline -->
                    <TextView
                    android:id="@+id/tvTotalInline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total: 2h 40m"
                    android:textSize="14sp"
                    android:textColor="#2C2C2C"
                        android:letterSpacing="0.0"
                    android:textStyle="bold"
                        tools:text="Total: 2h 40m"/>

                    <!-- Top task inline -->
                    <TextView
                    android:id="@+id/tvTopTaskInline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Top task: Revise Kotlin (1h 10m)"
                    android:textSize="13sp"
                    android:textColor="#4A4A4A"
                        android:letterSpacing="0.0"
                        tools:text="Top task: Revise Kotlin (1h 10m)"/>

                    <!-- Sessions inline -->
                    <TextView
                    android:id="@+id/tvSessionsInline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Sessions: 3"
                    android:textSize="13sp"
                    android:textColor="#4A4A4A"
                        android:letterSpacing="0.0"
                        tools:text="Sessions: 3"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Task count label -->
            <TextView
                android:id="@+id/tvTasksCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 tasks"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/premium_text_primary"
                android:letterSpacing="0.01"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/cardSummary"
                app:layout_constraintStart_toStartOf="parent"
                tools:text="3 tasks"/>

            <!-- Task list RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTasks"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/tvTasksCount"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

