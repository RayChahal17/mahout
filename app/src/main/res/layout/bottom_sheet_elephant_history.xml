<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FF121212"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mood history"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:alpha="0.95" />

    <TextView
        android:id="@+id/tvEleTrends"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/elephant_trends_placeholder"
        android:textColor="@android:color/white"
        android:alpha="0.7"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvEleHistoryEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/elephant_history_empty"
        android:textColor="@android:color/white"
        android:alpha="0.7"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEleHistory"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="12dp"
        android:overScrollMode="never" />

</LinearLayout>
