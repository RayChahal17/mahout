<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootMahout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mahout_screen"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Visual-only hero layer -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/heroContainer"
        android:layout_width="0dp"
        android:layout_height="220dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivHero"
            android:layout_width="220dp"
            android:layout_height="110dp"
            android:layout_marginTop="18dp"
            android:alpha="0.18"
            android:scaleType="centerInside"
            android:src="@drawable/logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:ignore="ContentDescription"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scroll content overlays the hero (no dead space block) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollMahout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="18dp"
            android:paddingBottom="26dp">

            <!-- Avatar -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAvatar"
                android:layout_width="148dp"
                android:layout_height="148dp"
                android:layout_marginTop="20dp"
                android:translationZ="20dp"
                app:cardCornerRadius="999dp"
                app:cardElevation="10dp"
                app:strokeColor="@android:color/white"
                app:strokeWidth="5dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/logo"
                    tools:ignore="ContentDescription" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Settings -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMahoutSettings"
                style="@style/Widget.Mahout.Button.PillPrimary2"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="18dp"
                android:contentDescription="@string/action_settings"
                app:icon="@android:drawable/ic_menu_preferences"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="22dp"
                app:iconTint="@android:color/white"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Name -->
            <TextView
                android:id="@+id/tvMahoutName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="#111111"
                app:layout_constraintTop_toBottomOf="@id/cardAvatar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Ray Chahal" />

            <!-- Edit -->
            <TextView
                android:id="@+id/tvMahoutEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/mahout_gold"
                app:layout_constraintBaseline_toBaselineOf="@id/tvMahoutName"
                app:layout_constraintStart_toEndOf="@id/tvMahoutName"
                tools:text="Edit" />

            <!-- Email -->
            <TextView
                android:id="@+id/tvMahoutEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="14sp"
                android:textColor="#66000000"
                app:layout_constraintTop_toBottomOf="@id/tvMahoutName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="raychahal17@gmail.com" />

            <!-- Tagline -->
            <TextView
                android:id="@+id/tvMahoutTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="14sp"
                android:textColor="#66000000"
                android:text="Write • reflect • choose your next step"
                app:layout_constraintTop_toBottomOf="@id/tvMahoutEmail"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:ignore="HardcodedText" />

            <!-- Section title -->
            <TextView
                android:id="@+id/tvMahoutTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="18dp"
                android:text="@string/tab_mahout"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="#111111"
                app:layout_constraintTop_toBottomOf="@id/tvMahoutTagline"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Segmented control -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tgMahoutMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_mahout_segment_container"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:clipToPadding="false"
                android:clipToOutline="true"
                android:outlineProvider="background"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@id/btnMahoutNewEntry"
                app:layout_constraintTop_toBottomOf="@id/tvMahoutTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMahoutNewEntry"
                    style="@style/Widget.Mahout.Button.SegmentItemDark.Left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="New Entry"
                    android:textSize="10sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMahoutFeeling"
                    style="@style/Widget.Mahout.Button.SegmentItemDark.Middle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Journal a feeling"
                    android:textSize="10sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMahoutPlan"
                    style="@style/Widget.Mahout.Button.SegmentItemDark.Middle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Plan next step"
                    android:textSize="10sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMahoutGratitude"
                    style="@style/Widget.Mahout.Button.SegmentItemDark.Right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Gratitude"
                    android:textSize="10sp" />

            </com.google.android.material.button.MaterialButtonToggleGroup>


            <!-- Main content card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMain"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/tgMahoutMode"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvTodayLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today"
                        android:textColor="#111111"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="HardcodedText" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/tvDateChip"
                        style="@style/Widget.Mahout.Chip.Neutral"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Dec 30"
                        app:layout_constraintBaseline_toBaselineOf="@id/tvTodayLabel"
                        app:layout_constraintStart_toEndOf="@id/tvTodayLabel"
                        tools:ignore="HardcodedText" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardNotepad"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="0dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTodayLabel"
                        app:strokeWidth="0dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_notepad_sheet"
                            android:padding="16dp">

                            <EditText
                                android:id="@+id/etJournal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:gravity="top"
                                android:hint="Write what’s on your mind..."
                                android:inputType="textMultiLine"
                                android:minLines="6"
                                android:textSize="16sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                tools:ignore="Autofill,HardcodedText" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvPrompts"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:overScrollMode="never"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/cardNotepad"
                        tools:listitem="@layout/item_mahout_prompt" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewPastEntries"
                style="@style/Widget.Mahout.Button.PillPrimary2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="14dp"
                android:alpha="0.90"
                android:text="View past entries →"
                app:layout_constraintTop_toBottomOf="@id/cardMain"
                app:layout_constraintStart_toStartOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
