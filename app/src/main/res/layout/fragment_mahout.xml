<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootMahout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mahout_bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Premium hero backdrop behind the fixed header (visual only). -->
    <View
        android:id="@+id/vHeroGradient"
        android:layout_width="0dp"
        android:layout_height="260dp"
        android:alpha="0.95"
        android:background="@drawable/bg_mahout_screen"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivHero"
        android:layout_width="220dp"
        android:layout_height="110dp"
        android:layout_marginTop="@dimen/mahout_space_16"
        android:alpha="0.14"
        android:scaleType="centerInside"
        android:src="@drawable/logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <!--
      FIXED HEADER (does NOT scroll)
      This solves: "top whole part ... does not slide up or down".
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerMahout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/mahout_space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Settings (gold circle icon button). -->
        <ImageButton
            android:id="@+id/btnMahoutSettings"
            android:layout_width="@dimen/mahout_btn_height"
            android:layout_height="@dimen/mahout_btn_height"
            android:layout_marginTop="@dimen/mahout_space_16"
            android:layout_marginEnd="@dimen/mahout_space_16"
            android:background="@drawable/ripple_mahout_pill_primary"
            android:contentDescription="@string/action_settings"
            android:scaleType="center"
            android:src="@android:drawable/ic_menu_preferences"
            android:tint="@color/mahout_on_accent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Avatar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAvatar"
            style="@style/Widget.Mahout.Card"
            android:layout_width="@dimen/mahout_avatar_size"
            android:layout_height="@dimen/mahout_avatar_size"
            android:layout_marginTop="@dimen/mahout_space_24"
            app:cardCornerRadius="@dimen/mahout_radius_pill"
            app:cardElevation="0dp"
            app:strokeColor="@color/mahout_outline_soft"
            app:strokeWidth="@dimen/mahout_stroke_1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/logo"
                tools:ignore="ContentDescription" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Name -->
        <TextView
            android:id="@+id/tvMahoutName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mahout_space_12"
            android:textAppearance="@style/TextAppearance.Mahout.TitleL"
            android:textColor="@color/mahout_text_primary"
            app:layout_constraintEnd_toStartOf="@id/tvMahoutEdit"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardAvatar"
            tools:text="Ray Chahal" />

        <!-- Edit (small outlined pill) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/tvMahoutEdit"
            style="@style/Widget.Mahout.Button.PillOutlineSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/mahout_space_8"
            android:text="@string/common_edit"
            app:layout_constraintBaseline_toBaselineOf="@id/tvMahoutName"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvMahoutName" />

        <!-- Email -->
        <TextView
            android:id="@+id/tvMahoutEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Mahout.BodyM"
            android:textColor="@color/mahout_text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvMahoutName"
            tools:text="raychahal17@gmail.com" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/tvMahoutTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mahout_space_8"
            android:textAppearance="@style/TextAppearance.Mahout.BodyM"
            android:textColor="@color/mahout_text_tertiary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvMahoutEmail"
            tools:text="Write • reflect • choose your next step" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--
      SCROLL AREA (everything below the fixed header)
    -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollMahout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/mahout_space_32"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerMahout">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/mahout_space_24">

            <!-- Gutter guidelines for premium rhythm -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/glStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="@dimen/mahout_space_24" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/glEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_end="@dimen/mahout_space_24" />

            <!-- Section title -->
            <TextView
                android:id="@+id/tvMahoutTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mahout_space_16"
                android:text="@string/tab_mahout"
                android:textAppearance="@style/TextAppearance.Mahout.TitleL"
                android:textColor="@color/mahout_text_primary"
                app:layout_constraintStart_toStartOf="@id/glStart"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Segmented control -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tgMahoutMode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mahout_space_12"
                android:background="@drawable/bg_mahout_segment_container"
                android:clipToOutline="true"
                android:clipToPadding="false"
                android:outlineProvider="background"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                app:singleSelection="true"
                app:layout_constraintEnd_toEndOf="@id/glEnd"
                app:layout_constraintStart_toStartOf="@id/glStart"
                app:layout_constraintTop_toBottomOf="@id/tvMahoutTitle">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMahoutNewEntry"
                    style="@style/Widget.Mahout.Button.SegmentItemDark.Left"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/mahout_type_new_entry" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMahoutFeeling"
                    style="@style/Widget.Mahout.Button.SegmentItemDark.Middle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/mahout_type_feeling" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMahoutPlan"
                    style="@style/Widget.Mahout.Button.SegmentItemDark.Middle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/mahout_type_plan" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMahoutGratitude"
                    style="@style/Widget.Mahout.Button.SegmentItemDark.Right"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/mahout_type_gratitude" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Main content card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMain"
                style="@style/Widget.Mahout.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mahout_space_16"
                app:layout_constraintEnd_toEndOf="@id/glEnd"
                app:layout_constraintStart_toStartOf="@id/glStart"
                app:layout_constraintTop_toBottomOf="@id/tgMahoutMode">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/mahout_space_16">

                    <TextView
                        android:id="@+id/tvTodayLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/today"
                        android:textAppearance="@style/TextAppearance.Mahout.TitleM"
                        android:textColor="@color/mahout_text_primary"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/tvDateChip"
                        style="@style/Widget.Mahout.Chip.Neutral"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/mahout_space_12"
                        app:layout_constraintBaseline_toBaselineOf="@id/tvTodayLabel"
                        app:layout_constraintStart_toEndOf="@id/tvTodayLabel"
                        tools:text="Jan 13" />

                    <!-- Notepad (DEFINED ID + properly constrained) -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/notepadContainer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mahout_space_12"
                        android:background="@drawable/bg_notepad_sheet"
                        android:padding="@dimen/mahout_space_12"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTodayLabel">

                        <EditText
                            android:id="@+id/etJournal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:gravity="top"
                            android:hint="@string/mahout_editor_hint"
                            android:includeFontPadding="false"
                            android:inputType="textMultiLine"
                            android:minLines="6"
                            android:padding="0dp"
                            android:textAppearance="@style/TextAppearance.Mahout.BodyL"
                            android:textColor="@color/mahout_ink"
                            android:textColorHint="@color/mahout_text_secondary"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:ignore="Autofill" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvPrompts"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mahout_space_12"
                        android:overScrollMode="never"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/notepadContainer"
                        tools:listitem="@layout/item_mahout_prompt" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewPastEntries"
                style="@style/Widget.Mahout.Button.PillOutlineSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mahout_space_16"
                android:text="@string/mahout_past_entries"
                app:layout_constraintStart_toStartOf="@id/glStart"
                app:layout_constraintTop_toBottomOf="@id/cardMain" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
